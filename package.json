{
  "name": "ai-qa",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "worker": "pnpm --filter @ai-qa/worker start",
    "lint": "pnpm -r --if-present lint",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "db:generate": "pnpm --filter @ai-qa/db db:generate",
    "db:migrate": "pnpm --filter @ai-qa/db db:migrate",
    "db:seed": "pnpm --filter @ai-qa/db db:seed",
    "enqueue": "pnpm --filter @ai-qa/worker enqueue",
    "demo": "pnpm db:migrate && pnpm --filter @ai-qa/worker demo",
    "test": "pnpm --filter @ai-qa/engine test",
    "typecheck": "pnpm -r typecheck && node node_modules/typescript/bin/tsc -p tests/e2e",
    "browser:install": "pnpm --filter @ai-qa/engine browser:install",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
