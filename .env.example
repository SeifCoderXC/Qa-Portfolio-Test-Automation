# Copy to .env (gitignored). Every value is optional unless noted.

# Encrypts stored login credentials (AES-256-GCM). Required only if a project has a login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Claude. Without it, planning and failure analysis use offline heuristics.
ANTHROPIC_API_KEY=
# Model overrides (defaults shown).
# PLAN_MODEL=claude-haiku-4-5
# ANALYZE_MODEL=claude-sonnet-5
# ASSISTANT_MODEL=claude-haiku-4-5

# Jira Cloud. If any of the four is empty, the bug page offers a bug.json download instead.
JIRA_BASE_URL=          # https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=         # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=

# Optional.
# DATABASE_PATH=./data/ai-qa.sqlite
# PLAYWRIGHT_CHANNEL=chrome   # use installed Google Chrome instead of Playwright's Chromium
# DEMO_URL=https://example.com
