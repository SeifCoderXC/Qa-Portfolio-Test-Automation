{
  "info": {
    "_postman_id": "5a1f0c2e-7d4b-4c1a-9e8f-a1b2c3d4e5f6",
    "name": "AI QA API",
    "description": "REST API of the local AI QA dashboard. Start it with `pnpm dev` (http://127.0.0.1:3000), select the \"AI QA local\" environment, then run the collection in order. No secrets are stored here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project (valid https URL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman demo\",\n  \"baseUrl\": \"https://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Saves the new id as {{projectId}} for the requests below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns an id\", () => pm.expect(body.id).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.collectionVariables.set(\"projectId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project rejects ftp:// (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"bad\",\n  \"baseUrl\": \"ftp://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"baseUrl error\", () => pm.expect(pm.response.json().details.baseUrl).to.eql(\"must be http or https\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project rejects user:pass@ in URL (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"bad\",\n  \"baseUrl\": \"https://user:pass@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"baseUrl error\", () => pm.expect(pm.response.json().details.baseUrl).to.eql(\"must not contain credentials\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same id\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"projectId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing project (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error message\", () => pm.expect(pm.response.json().error).to.eql(\"project not found\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project with login (password never returned)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman login demo\",\n  \"baseUrl\": \"https://example.com\",\n  \"loginEmail\": \"qa@example.invalid\",\n  \"loginPassword\": \"{{canaryPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "canaryPassword is a fake value used only to prove the API never echoes it. Requires APP_SECRET in the server's .env."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"hasLogin true\", () => pm.expect(pm.response.json().hasLogin).to.eql(true));",
                  "pm.test(\"password not in response\", () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get(\"canaryPassword\")));",
                  "pm.collectionVariables.set(\"loginProjectId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project with login (secret kinds only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{loginProjectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{loginProjectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lists secret kinds, not values\", () => pm.expect(pm.response.json().secretKinds).to.have.members([\"loginEmail\", \"loginPassword\"]));",
                  "pm.test(\"password not in response\", () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get(\"canaryPassword\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Queue discover job (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"discover\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Queues a crawl. Nothing runs until `pnpm worker` is started."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"queued\", () => pm.expect(pm.response.json().status).to.eql(\"queued\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown job type (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ping\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"type error\", () => pm.expect(pm.response.json().details.type).to.include(\"discover\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "loginProjectId",
      "value": ""
    },
    {
      "key": "canaryPassword",
      "value": "canary-not-a-real-password-7431"
    }
  ]
}