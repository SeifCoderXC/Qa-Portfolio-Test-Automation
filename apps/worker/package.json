{
  "name": "@ai-qa/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "drain": "node --env-file-if-exists=../../.env --import tsx src/index.ts --drain",
    "enqueue": "node --env-file-if-exists=../../.env --import tsx scripts/enqueue.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "demo": "node --env-file-if-exists=../../.env --import tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@ai-qa/db": "workspace:*",
    "@ai-qa/engine": "workspace:*"
  }
}
